# verbacue.app in /Applications, from the release DMG (universal: Apple Silicon and Intel).
# Generated by packaging/homebrew/make-tap.sh in github.com/ksrichard/verbacue;
# edit the template there, not this file.
cask "verbacue-app" do
  version "@VERSION@"
  sha256 "@SHA256_DMG@"

  url "https://github.com/ksrichard/verbacue/releases/download/v#{version}/verbacue-#{version}-macos-universal.dmg"
  name "verbacue"
  desc "Transcribe, translate and lay out subtitles for any video, on your own computer"
  homepage "https://github.com/ksrichard/verbacue"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The app also holds the command line. Casks cannot declare a conflict with a
  # formula; with the formula installed, linking the binary below fails instead.
  depends_on macos: ">= :big_sur"

  app "verbacue.app"
  binary "#{appdir}/verbacue.app/Contents/MacOS/verbacue"

  zap trash: [
    "~/.config/verbacue",
    "~/Library/Caches/verbacue",
  ]

  caveats <<~EOS
    verbacue is not notarized by Apple. At the first start macOS blocks it: open it
    once, then choose Open Anyway in System Settings > Privacy & Security.
    The formula (brew install ksrichard/verbacue/verbacue) has the same app as
    `verbacue gui` and needs no confirmation.
  EOS
end
