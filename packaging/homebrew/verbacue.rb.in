# The verbacue command and desktop app (`verbacue gui`), from the release binaries.
# Generated by packaging/homebrew/make-tap.sh in github.com/ksrichard/verbacue;
# edit the template there, not this file.
class Verbacue < Formula
  desc "Transcribe, translate and lay out subtitles for any video, on your own computer"
  homepage "https://github.com/ksrichard/verbacue"
  version "@VERSION@"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    # One universal binary for Apple Silicon and Intel, with Metal.
    url "https://github.com/ksrichard/verbacue/releases/download/v#{version}/verbacue-macos-universal-metal.tar.gz"
    sha256 "@SHA256_MACOS@"
  end

  on_linux do
    # The CPU builds with the desktop app; they need glibc 2.35 or newer.
    on_intel do
      url "https://github.com/ksrichard/verbacue/releases/download/v#{version}/verbacue-linux-amd64-cpu-gui.tar.gz"
      sha256 "@SHA256_LINUX_AMD64@"
    end
    on_arm do
      url "https://github.com/ksrichard/verbacue/releases/download/v#{version}/verbacue-linux-arm64-cpu-gui.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
  end

  def install
    bin.install "verbacue"
    prefix.install "LICENSE", "THIRD-PARTY-LICENSES.txt"
  end

  def caveats
    text = <<~EOS
      `verbacue` with no arguments, or `verbacue gui`, opens the desktop app.
      Models are downloaded on first use into the cache folder.
    EOS
    if OS.linux?
      text += <<~EOS
        On Linux the app needs a desktop (X11 or Wayland) with libxkbcommon; the
        command line works without one, for example in WSL or over SSH.
      EOS
    end
    text
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/verbacue --version")
  end
end
